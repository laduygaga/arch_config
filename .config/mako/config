# ~/.config/mako/config
# 100% valid Mako syntax — works with `mako` and `makoctl reload`

# --- GLOBAL ---

anchor=top-right
margin=10,10
width=300
height=300
max-visible=20

font=Monospace 8
markup=true
format=<b>%s</b>\n%b

border-size=3
border-color=#aaaaaa
padding=8

icon-location=left
max-icon-size=128

default-timeout=10000

layer=overlay
sort=-time

# --- URGENCY LEVELS (CORRECT SYNTAX) ---

[urgency=low]
background-color=#222222
text-color=#888888
default-timeout=10000

[urgency=normal]
background-color=#ededcc
text-color=#000000
default-timeout=10000

[urgency=critical]
background-color=#900000
text-color=#ffffff
border-color=#ff0000
default-timeout=0
