{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "oh-my-openagent@latest",
    "opencode-antigravity-auth@latest",
    "@sunerpy/opencode-kiro-auth"
  ],
  "provider": {
    "google": {
      "npm": "@ai-sdk/google",
      "name": "Google Antigravity Auth",
      "models": {
        "antigravity-gemini-3-flash": {
          "name": "Gemini 3 Flash (Oauth)"
        },
        "antigravity-gemini-3.1-pro": {
          "name": "Gemini 3.1 pro (low,high) (Oauth)"
        },
        "antigravity-claude-sonnet-4-6": {
          "name": "Claude Sonnet 4.6 (Oauth)"
        },
        "gemini-2.5-flash": {
          "name": "Gemini 2.5 Flash (Oauth)"
        },
        "gemini-3-flash-preview": {
          "name": "Gemini 3 Flash Preview (Oauth)"
        },
        "gemini-3.1-flash-lite": {
          "name": "Gemini 3.1 Flash Lite (Oauth)"
        },
        "gemma-4-31b": {
          "name": "Gemma 4 31B (Oauth)"
        },
        "gemini-3.1-pro-preview": {
          "name": "Gemini 3.1 Pro Preview (Oauth)"
        }
      }
    },
    "bifrost-gemini": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Gemini Multi-Key Pool",
      "options": {
        "baseURL": "http://127.0.0.1:4000/v1",
        "apiKey": "placeholder-token"
      },
      "models": {
        "gemini-2.5-flash": {
          "name": "Gemini 2.5 Flash (bifrost)"
        },
        "gemini-3-flash-preview": {
          "name": "Gemini 3 Flash Preview(bifrost)"
        },
        "gemini-3-flash": {
          "name": "Gemini 3 Flash (bifrost)"
        },
        "gemini-3.5-flash-lite": {
          "name": "Gemini 3.5 Flash Lite (bifrost)"
        },
        "gemini-3.5-flash": {
          "name": "Gemini 3.5 Flash (bifrost)"
        },
        "gemini-3.6-flash": {
          "name": "Gemini 3.6 Flash (bifrost)"
        },
        "gemini-3.7-flash": {
          "name": "Gemini 3.7 Flash (bifrost)"
        },
        "gemini-3.8-flash": {
          "name": "Gemini 3.8 Flash (bifrost)"
        },
        "gemini-3.1-flash-lite": {
          "name": "Gemini 3.1 Flash Lite (bifrost)"
        },
        "gemini-2.5-flash-lite": {
          "name": "Gemini 2.5 Flash Lite (bifrost)"
        },
        "gemma-4-31b": {
          "name": "Gemma 4 31B (bifrost)"
        }
      }
    },
    "kiro-auth": {
      "name": "Kiro Auth Provider",
      "models": {
        "gpt-5.6-sol": {
          "name": "GPT 5.6 Sol (Kiro)"
        },
        "gpt-5.6-terra": {
          "name": "GPT 5.6 Terra (Kiro)"
        },
        "gpt-5.6-luna": {
          "name": "GPT 5.6 Luna (Kiro)"
        },
        "qwen3-coder-next": {
          "name": "Qwen3 Coder Next (Kiro)"
        },
        "auto": {
          "name": "Auto / Default (Kiro)"
        },
        "claude-3-5-sonnet": {
          "name": "Claude 3.5 Sonnet (Kiro)"
        },
        "claude-3-7-sonnet": {
          "name": "Claude 3.7 Sonnet (Kiro)"
        }
      }
    }
  },
  "model": "kiro-auth/gpt-5.6-sol",
  "categories": {
    "ultrabrain": {
      "model": "kiro-auth/gpt-5.6-terra"
    },
    "quick": {
      "model": "kiro-auth/qwen3-coder-next"
    },
    "visual-engineering": {
      "model": "kiro-auth/gpt-5.6-luna"
    }
  },
  "agents": {
    "sisyphus": {
      "model": "kiro-auth/gpt-5.6-sol"
    },
    "oracle": {
      "model": "kiro-auth/gpt-5.6-terra"
    },
    "explore": {
      "model": "kiro-auth/qwen3-coder-next"
    },
    "librarian": {
      "models": [
        "kiro-auth/qwen3-coder-next"
      ]
    }
  }
}
