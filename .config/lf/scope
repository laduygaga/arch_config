#!/bin/sh

# File preview handler for lf.

set -C -f
IFS="$(printf '%b_' '\n')"; IFS="${IFS%_}"

# Skip preview for files larger than 100MB or specific files that cause lag
FILE_SIZE=$(stat --printf '%s' -- "$1" 2>/dev/null || echo 0)
MAX_SIZE=$((100 * 1024 * 1024))  # 100MB

if [ "$FILE_SIZE" -gt "$MAX_SIZE" ]; then
	echo "File too large to preview ($(( FILE_SIZE / 1024 / 1024 ))MB)"
	exit 1
fi

image() {
	# 1. If inside a TMUX session, completely bypass the slow X11 Ueberzug overlay.
	# WezTerm processes inline protocols instantly inside tmux panes.
	if [ -n "$TMUX" ]; then
		if command -v chafa >/dev/null 2>&1; then
			chafa -f sixel -s "${2}x${3}" "$1"
			exit 1  # Crucial: Tells lf not to wait or try to cache text layout
		fi
	fi

	# 2. Native Outside-TMUX Logic (Your original code)
	if [ -n "$DISPLAY" ] && [ -z "$WAYLAND_DISPLAY" ] && command -v ueberzug >/dev/null 2>&1; then
		# X11 Ueberzug (works outside tmux out-of-the-box)
		printf '{"action": "add", "identifier": "PREVIEW", "x": "%s", "y": "%s", "width": "%s", "height": "%s", "scaler": "contain", "path": "%s"}\n' "$4" "$5" "$(($2-1))" "$(($3-1))" "$1" > "$FIFO_UEBERZUG"
	elif command -v chafa >/dev/null 2>&1; then
		# Fallback to Chafa (Wayland, SSH, etc.)
		chafa -f sixel -s "${2}x${3}" "$1"
	else
		mediainfo "$1"
	fi
}

ifub() {
	[ -n "$DISPLAY" ] && [ -z "$WAYLAND_DISPLAY" ] && command -V ueberzug >/dev/null 2>&1
}

# Note that the cache file name is a function of file information, meaning if
# an image appears in multiple places across the machine, it will not have to
# be regenerated once seen.

case "$(file --dereference --brief --mime-type -- "$1")" in
	image/*) image "$1" "$2" "$3" "$4" "$5" ;;
	text/html) lynx -width="$4" -display_charset=utf-8 -dump "$1"  ;;
	text/troff) man ./ "$1" | col -b ;;
	application/json) cat "$1" | jq ;;
	application/x-ndjson) cat "$1";;
	text/csv)
		ENCODING=$(file -b --mime-encoding -- "$1" 2>/dev/null || echo "utf-8")
		head -n 100 -- "$1" | iconv -f "$ENCODING" -t utf-8 -c 2>/dev/null
		;;
	text/* | */xml | application/json) highlight -O ansi "$1" || cat "$1";;
	application/zip| application/gzip) atool --list -- "$1" ;;
    audio/* | application/octet-stream) mediainfo "$1" || exit 1;;
	video/* )
		CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/lf/thumb.$(stat --printf '%n\0%i\0%F\0%s\0%W\0%Y' -- "$(readlink -f "$1")" | sha256sum | awk '{print $1}')"
		[ ! -f "$CACHE" ] && ffmpegthumbnailer -i "$1" -o "$CACHE" -s 0
		image "$CACHE" "$2" "$3" "$4" "$5"
		;;
        */pdf)
		CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/lf/thumb.$(stat --printf '%n\0%i\0%F\0%s\0%W\0%Y' -- "$(readlink -f "$1")" | sha256sum | awk '{print $1}')"
		[ ! -f "$CACHE.jpg" ] && pdftoppm -jpeg -f 1 -singlefile "$1" "$CACHE"
		image "$CACHE.jpg" "$2" "$3" "$4" "$5"
		;;
        *opendocument*) odt2txt "$1" ;;
	application/pgp-encrypted) gpg -d -- "$1" ;;
esac
exit 1
